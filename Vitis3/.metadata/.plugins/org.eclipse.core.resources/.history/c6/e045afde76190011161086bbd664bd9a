#include "ff.h"
#include "diskio.h"
#include "xsdps.h"
#include "xparameters.h"
#include "xstatus.h"
#include <string.h>

#ifndef XPAR_XSDPS_0_DEVICE_ID
#error "XPAR_XSDPS_0_DEVICE_ID not found. Enable PS SD controller in Vivado."
#endif

static XSdPs SdInstance;
static int SdInitialized = 0;

static DSTATUS xlate_status(int ok) {
    return ok ? 0 : STA_NOINIT;
}

DSTATUS disk_initialize(BYTE pdrv)
{
    XSdPs_Config *Cfg;
    int Status;

    if (pdrv != 0)
        return STA_NOINIT;

    if (SdInitialized)
        return 0;

    Cfg = XSdPs_LookupConfig(XPAR_XSDPS_0_DEVICE_ID);
    if (Cfg == NULL)
        return STA_NOINIT;

    Status = XSdPs_CfgInitialize(&SdInstance, Cfg, Cfg->BaseAddress);
    if (Status != XST_SUCCESS)
        return STA_NOINIT;

    Status = XSdPs_CardInitialize(&SdInstance);
    if (Status != XST_SUCCESS)
        return STA_NOINIT;

    SdInitialized = 1;
    return 0;
}

DSTATUS disk_status(BYTE pdrv)
{
    if (pdrv != 0)
        return STA_NOINIT;

    return SdInitialized ? 0 : STA_NOINIT;
}

DRESULT disk_read(BYTE pdrv, BYTE *buff, LBA_t sector, UINT count)
{
    int Status;

    if (pdrv != 0 || buff == NULL || count == 0)
        return RES_PARERR;

    if (disk_initialize(pdrv) & STA_NOINIT)
        return RES_NOTRDY;

    Status = XSdPs_ReadPolled(&SdInstance, (u32)sector, count, buff);
    if (Status != XST_SUCCESS)
        return RES_ERROR;

    return RES_OK;
}

#if FF_FS_READONLY == 0
DRESULT disk_write(BYTE pdrv, const BYTE *buff, LBA_t sector, UINT count)
{
    int Status;

    if (pdrv != 0 || buff == NULL || count == 0)
        return RES_PARERR;

    if (disk_initialize(pdrv) & STA_NOINIT)
        return RES_NOTRDY;

    Status = XSdPs_WritePolled(&SdInstance, (u32)sector, count, (u8 *)buff);
    if (Status != XST_SUCCESS)
        return RES_ERROR;

    return RES_OK;
}
#endif

DRESULT disk_ioctl(BYTE pdrv, BYTE cmd, void *buff)
{
    if (pdrv != 0)
        return RES_PARERR;

    if (disk_initialize(pdrv) & STA_NOINIT)
        return RES_NOTRDY;

    switch (cmd) {
    case CTRL_SYNC:
        return RES_OK;

    case GET_SECTOR_COUNT:
        if (buff == NULL) return RES_PARERR;
        *(LBA_t *)buff = SdInstance.SectorCount;
        return RES_OK;

    case GET_SECTOR_SIZE:
        if (buff == NULL) return RES_PARERR;
        *(WORD *)buff = 512;
        return RES_OK;

    case GET_BLOCK_SIZE:
        if (buff == NULL) return RES_PARERR;
        *(DWORD *)buff = 1;
        return RES_OK;

    default:
        return RES_PARERR;
    }
}

DWORD get_fattime(void)
{
    /* 2025-01-01 00:00:00 */
    return ((DWORD)(2025 - 1980) << 25)
         | ((DWORD)1 << 21)
         | ((DWORD)1 << 16)
         | ((DWORD)0 << 11)
         | ((DWORD)0 << 5)
         | ((DWORD)0 >> 1);
}
