#include "xil_printf.h"
#include "ff.h"

int main(void)
{
    FATFS fs;
    FIL fil;
    FRESULT r;

    xil_printf("FatFs test\r\n");

    r = f_mount(&fs, "0:/", 1);
    xil_printf("mount = %d\r\n", r);

    r = f_open(&fil, "0:/test.txt", FA_READ);
    xil_printf("open = %d\r\n", r);

    if (r == FR_OK) {
        f_close(&fil);
        xil_printf("close ok\r\n");
    }

    while (1) {}
    return 0;
}
