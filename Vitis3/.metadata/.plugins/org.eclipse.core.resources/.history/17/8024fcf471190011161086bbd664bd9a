#include "xil_printf.h"
#include "xparameters.h"
#include "xil_io.h"
#include "sleep.h"
#include "xil_types.h"
#include "ff.h"

#define SPEED_REG XPAR_SPEED_GPIO_BASEADDR   // 8-bit GPIO

int main(void)
{

    xil_printf("FatFs test\r\n");

    FATFS fs;
    FIL fil;
    FRESULT r;

    /* Turn LED/GPIO off initially */
    Xil_Out8(SPEED_REG, 0);

    /* Mount filesystem */
    r = f_mount(&fs, "0:/", 1);
    xil_printf("mount = %d\r\n", r);

    if (r == FR_OK) {

        /* Turn LED/GPIO ON if mount succeeded */
        Xil_Out8(SPEED_REG, 1);

        xil_printf("Mount success\r\n");

        r = f_open(&fil, "0:/RUNG.G", FA_READ);
        xil_printf("open = %d\r\n", r);

        if (r == FR_OK) {
            xil_printf("File opened\r\n");
            f_close(&fil);
        }

    } else {

        /* Ensure LED stays OFF if mount fails */
        Xil_Out8(SPEED_REG, 0);

        xil_printf("Mount failed\r\n");
    }

    while (1) {
        sleep(1);
    }

    return 0;
}
